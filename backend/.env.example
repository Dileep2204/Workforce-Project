APP_NAME=SSKATT Workforce API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://sskatt:sskatt_local_password@db:5432/sskatt
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend-domain.example
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-this-before-starting
SEED_DEMO=false
